// Weapon movesets. Local frame: x = right, y = up, z = forward.
// Stamina: without an explicit `stamina`, an attack costs its total damage × `stamina_per_damage`
// (player.ron): for equal damage, rapier and greatsword cost the same.
// `arc: (start, end)` rotates the capsule around the vertical axis (positive = to the left).
(
    weapons: [
        // ------------------------------------------------------------------ Rapier
        (
            name: (en: "Rapier", fr: "Rapière"),
            description: (en: "Quick, precise thrusts: best against a single target.",
                          fr: "Estocades rapides et précises : idéale contre une cible unique."),
            light: [
                (
                    anim: "rapier_light1", total: 24,
                    track_until: 7, track_rate: 540,
                    chain_from: 13, cancel_from: 12,
                    motion: [(start: 3, end: 9, speed: 2.2)],
                    hits: [(start: 8, end: 11, damage: 42, stagger: 3, hitstop: 3,
                            capsule: (a: (0.15, 1.25, 0.4), b: (0.1, 1.25, 1.75), r: 0.14))],
                ),
                (
                    anim: "rapier_light2", total: 24,
                    track_until: 6, track_rate: 540,
                    chain_from: 12, cancel_from: 12,
                    motion: [(start: 2, end: 8, speed: 2.2)],
                    hits: [(start: 7, end: 10, damage: 42, stagger: 3, hitstop: 3,
                            capsule: (a: (0.1, 1.1, 0.4), b: (0.0, 1.15, 1.75), r: 0.14))],
                ),
                (
                    anim: "rapier_light3", total: 26,
                    track_until: 6, track_rate: 540,
                    chain_from: 14, cancel_from: 13,
                    motion: [(start: 2, end: 9, speed: 2.6)],
                    hits: [(start: 8, end: 12, damage: 44, stagger: 4, hitstop: 3,
                            arc: (-35, 35),
                            capsule: (a: (0.0, 1.2, 0.4), b: (0.0, 1.2, 1.6), r: 0.14))],
                ),
                (
                    anim: "rapier_light4", total: 36,
                    track_until: 10, track_rate: 480,
                    chain_from: 24, cancel_from: 20,
                    motion: [(start: 6, end: 13, speed: 4.5)],
                    hits: [(start: 12, end: 15, damage: 58, stagger: 7, hitstop: 4,
                            capsule: (a: (0.1, 1.2, 0.4), b: (0.0, 1.2, 1.95), r: 0.15))],
                ),
            ],
            heavy: (
                anim: "rapier_heavy", total: 40,
                track_until: 12, track_rate: 420,
                chain_from: 30, cancel_from: 26,
                motion: [(start: 8, end: 16, speed: 6.0)],
                hits: [(start: 14, end: 18, damage: 72, stagger: 10, hitstop: 5,
                        capsule: (a: (0.1, 1.2, 0.4), b: (0.0, 1.2, 2.0), r: 0.16))],
            ),
            heavy_charged: (
                anim: "rapier_heavy_charged", total: 44,
                track_until: 6, track_rate: 420,
                chain_from: 32, cancel_from: 28,
                hyperarmor: (0, 14),
                motion: [(start: 2, end: 12, speed: 11.0)],
                hits: [(start: 8, end: 13, damage: 110, stagger: 34, hitstop: 7,
                        capsule: (a: (0.1, 1.2, 0.4), b: (0.0, 1.2, 2.2), r: 0.18))],
            ),
            charge_ticks: 36,
            charge_anim: "rapier_charge",
            // Lightning lunge: dash then a flurry of thrusts. Fixed stamina cost, and its hits don't
            // recharge the special gauge: it has to be worth the full gauge on its own. Damage, not
            // stagger: the stagger mostly comes from the charged heavy attack.
            special: (
                anim: "rapier_special", total: 62, stamina: 30,
                track_until: 8, track_rate: 600,
                hyperarmor: (0, 40),
                cancel_from: 50,
                motion: [(start: 4, end: 13, speed: 13.0), (start: 13, end: 38, speed: 0.8)],
                hits: [
                    (start: 13, end: 15, damage: 48, stagger: 2, hitstop: 3,
                     capsule: (a: (0.1, 1.3, 0.4), b: (0.0, 1.3, 1.8), r: 0.16)),
                    (start: 19, end: 21, damage: 48, stagger: 2, hitstop: 3,
                     capsule: (a: (0.1, 1.0, 0.4), b: (0.0, 1.0, 1.8), r: 0.16)),
                    (start: 25, end: 27, damage: 48, stagger: 2, hitstop: 3,
                     capsule: (a: (0.1, 1.4, 0.4), b: (0.0, 1.4, 1.8), r: 0.16)),
                    (start: 34, end: 38, damage: 120, stagger: 8, hitstop: 8,
                     capsule: (a: (0.1, 1.2, 0.4), b: (0.0, 1.2, 2.1), r: 0.2)),
                ],
            ),
            fatal: (
                anim: "rapier_fatal", total: 96, stamina: 0,
                iframes: (0, 96),
                hits: [(start: 46, end: 48, damage: 220, hitstop: 10,
                        capsule: (a: (0.0, 1.2, 0.3), b: (0.0, 1.4, 2.2), r: 0.35))],
            ),
            // Jump attack: a plunging thrust. The jump has already paid its stamina.
            jump: (
                anim: "rapier_jump", total: 34, stamina: 6,
                chain_from: 24, cancel_from: 22,
                hits: [(start: 6, end: 12, damage: 70, stagger: 12, hitstop: 5,
                        capsule: (a: (0.1, 1.4, 0.4), b: (0.0, 0.5, 1.7), r: 0.18))],
            ),
        ),
        // ------------------------------------------------------------------ Greatsword
        // Slow and heavy: long reach, hyper armour during swings, big stagger.
        (
            name: (en: "Greatsword", fr: "Espadon"),
            description: (en: "Slow, wide sweeping blows: best against groups of enemies.",
                          fr: "Coups lents et larges qui balaient : idéal contre un groupe d'ennemis."),
            light: [
                (
                    anim: "greatsword_light1", total: 52,
                    track_until: 14, track_rate: 330,
                    chain_from: 32, cancel_from: 30,
                    hyperarmor: (8, 27),
                    motion: [(start: 10, end: 22, speed: 2.2)],
                    hits: [(start: 20, end: 26, damage: 78, stagger: 13, hitstop: 6,
                            arc: (-80, 70),
                            capsule: (a: (0.0, 1.15, 0.6), b: (0.0, 1.0, 2.9), r: 0.24))],
                ),
                (
                    anim: "greatsword_light2", total: 52,
                    track_until: 14, track_rate: 330,
                    chain_from: 32, cancel_from: 30,
                    hyperarmor: (8, 27),
                    motion: [(start: 10, end: 22, speed: 2.2)],
                    hits: [(start: 20, end: 26, damage: 78, stagger: 13, hitstop: 6,
                            arc: (75, -75),
                            capsule: (a: (0.0, 1.15, 0.6), b: (0.0, 1.0, 2.9), r: 0.24))],
                ),
                (
                    anim: "greatsword_light3", total: 64,
                    track_until: 18, track_rate: 280,
                    chain_from: 42, cancel_from: 40,
                    hyperarmor: (10, 32),
                    motion: [(start: 14, end: 26, speed: 2.6)],
                    hits: [(start: 26, end: 31, damage: 98, stagger: 18, hitstop: 7,
                            capsule: (a: (0.0, 0.6, 0.6), b: (0.0, 0.45, 3.0), r: 0.28))],
                ),
            ],
            heavy: (
                anim: "greatsword_heavy", total: 72,
                track_until: 20, track_rate: 280,
                chain_from: 50, cancel_from: 48,
                hyperarmor: (10, 38),
                motion: [(start: 16, end: 30, speed: 2.4)],
                hits: [(start: 32, end: 38, damage: 130, stagger: 28, hitstop: 8,
                        capsule: (a: (0.0, 0.5, 0.6), b: (0.0, 0.35, 3.1), r: 0.3))],
            ),
            heavy_charged: (
                anim: "greatsword_heavy_charged", total: 70,
                track_until: 8, track_rate: 280,
                chain_from: 50, cancel_from: 48,
                hyperarmor: (0, 26),
                motion: [(start: 4, end: 18, speed: 3.8)],
                hits: [(start: 18, end: 24, damage: 200, stagger: 58, hitstop: 10,
                        capsule: (a: (0.0, 0.5, 0.6), b: (0.0, 0.35, 3.2), r: 0.34))],
            ),
            charge_ticks: 54,
            charge_anim: "greatsword_charge",
            // Leaping cleave: takes off, hangs for an instant at the top, then comes crashing
            // down with a vertical cut that reaches high and far ahead (`lift`: vertical speed).
            // Fixed cost, its own hits don't recharge the gauge and stagger little (see the rapier).
            special: (
                anim: "greatsword_special", total: 78, stamina: 35,
                track_until: 26, track_rate: 240,
                hyperarmor: (0, 44),
                cancel_from: 62,
                motion: [
                    (start: 6, end: 14, speed: 2.5, lift: 9.0),
                    (start: 14, end: 20, speed: 1.5, lift: 4.0),
                    (start: 20, end: 28, lift: 0.0),
                    (start: 28, end: 40, speed: 2.0, lift: -16.0),
                ],
                hits: [(start: 28, end: 36, damage: 320, stagger: 20, hitstop: 12, slash: true,
                        capsule: (a: (0.0, 2.6, 0.7), b: (0.0, 0.2, 4.8), r: 0.55))],
            ),
            fatal: (
                anim: "greatsword_fatal", total: 104, stamina: 0,
                iframes: (0, 104),
                hits: [(start: 52, end: 54, damage: 300, hitstop: 12,
                        capsule: (a: (0.0, 1.2, 0.3), b: (0.0, 1.4, 2.8), r: 0.45))],
            ),
            // Jump attack: the sword brought down with all its weight while landing.
            jump: (
                anim: "greatsword_jump", total: 54, stamina: 14,
                chain_from: 40, cancel_from: 38,
                hyperarmor: (0, 22),
                hits: [(start: 12, end: 19, damage: 160, stagger: 34, hitstop: 8,
                        capsule: (a: (0.0, 1.5, 0.6), b: (0.0, 0.3, 3.0), r: 0.3))],
            ),
        ),
    ],
)
