// The other bosses (the Automaton is in boss.ron), and the encounters offered at the checkpoint.
// Same format as boss.ron, plus:
//
// - model / scale / tint: model (assets/models/<model>.glb, tools/blender/trial_bosses.py),
//   its scale and a tint. All distances (capsules, parts, spells) are in metres
//   in the game, so at the model's scale.
// - minor: supporting role (the butcher's dogs): small bar above it, and its death
//   isn't required for victory. When one lead falls, the other enters phase 2.
// - keep_away: within this distance, it backs away (spellcaster).
// - parts: hittable zones on top of the body, and lockable points (right stick
//   or mouse to switch between them). `bone`: the model object followed by the reticle.
// - spells: spells cast by the attacks' `casts`. Bolt: projectile (speed, homing in
//   degrees/s, life in ticks, delay: ticks hanging where it appears before heading for its target);
//   if it crashes on the ground, it keeps burning there for a while. Eruption: column bursting from the ground after `delay` ticks
//   of warning (area marked on the ground), lasting `life` ticks; neither guard nor parry.
//   Beam: continuous stream from the mouth to the ground, which it hits `reach` (min, max) metres
//   in front of the mouth depending on the target at cast time; it follows the caster for `life` ticks.
//   Spells from the same attack only hit once.
// - casts: (at: tick, spell, from: local starting point, aim: Target | Forward | Ring,
//   count, spread: fan in degrees (projectiles) or radius in metres (eruptions),
//   step: spacing of eruptions in a line, delay_step: delay of each eruption after the previous one).
// - min_angle: backwards attack (tail swipe): the target must be at least at this angle.
// - side: Left | Right, side where the target must be (pivots).
// - motion.turn: rotation in place during the segment (degrees, positive = to the left).
// - heading_slack: large beast that doesn't aim exactly at its target (degrees of tolerance);
//   it only turns when the target leaves this cone, and only advances when facing it.
// - climb: jump between levels (its `to_target` + `retarget` jump also follows the target's
//   height). After the target has stood this many ticks on a gallery or the stairs above the boss,
//   it's the only attack it chooses (whatever its range and cooldown); perched up there, it jumps
//   back down at once when the target is below. Never chosen otherwise.
(
    encounters: [
        (name: (en: "The Soot Wyvern", fr: "La Vouivre de Suie"),
         members: [(boss: "dragon", offset: (0, 1))]),
        (name: (en: "The Butcher", fr: "Le Boucher"),
         members: [(boss: "butcher"), (boss: "butcher_hound", offset: (-3, -2.5)), (boss: "butcher_hound", offset: (3, -2))]),
        (name: (en: "The Wick-Trimmer and the Anvil", fr: "Le Falotier et l'Enclume"),
         members: [(boss: "lamplighter", offset: (-3, 1.5)), (boss: "anvil", offset: (2.6, 0))]),
        (name: (en: "The Great Marionette", fr: "La Grande Marionnette"),
         members: [(boss: "marionette", offset: (0, 0.5))]),
        (name: (en: "The Rimeback", fr: "L'Échine-de-Givre"),
         members: [(boss: "spine_beast", offset: (0, 1))]),
        (name: (en: "The Dead-Hearth Giant", fr: "Le Géant de l'Âtre Mort"),
         members: [(boss: "giant", offset: (0, 2))]),
    ],

    bosses: [
        // ================================================================= ash wyvern
        // Huge: you lock onto its head, legs or tail. It doesn't aim: it's a
        // big beast that moves roughly towards its prey. In front of it, headbutt or body slam;
        // on its flank, it pivots a quarter turn whipping its tail; behind, the
        // tail sweeps. From afar, a fire stream; in phase 2, it takes flight.
        (
            key: "dragon", model: "dragon", scale: 1.5,
            name: (en: "The Soot Wyvern", fr: "La Vouivre de Suie"),
            max_hp: 5200, phase2_at: 0.5, radius: 2.6, height: 4.4, mass: 30,
            walk_speed: 2.2, strafe_speed: 0, turn_rate: 60, heading_slack: 25, preferred_range: 5.5,
            stagger_max: 170, stagger_delay: 200, stagger_decay: 8, idle_ticks: (40, 80), aggro_ticks: 240,
            color: (1.0, 0.42, 0.06),
            groggy: (anim: "groggy", total: 220),
            fatal_received: (anim: "fatal_received", total: 130),
            roar: (anim: "roar", total: 130, hyperarmor: (0, 130)),
            death: (anim: "death", total: 200),
            parts: [
                (at: (0, 5.6, 6.6), r: 1.1, bone: "lock_head"),
                (at: (1.65, 1.2, 2.3), r: 0.8, bone: "lock_fleg_R"),
                (at: (-1.65, 1.2, 2.3), r: 0.8, bone: "lock_fleg_L"),
                (at: (1.65, 1.4, -1.8), r: 0.8, bone: "lock_hleg_R"),
                (at: (-1.65, 1.4, -1.8), r: 0.8, bone: "lock_hleg_L"),
                (at: (0, 2.0, -6.5), r: 1.0, bone: "lock_tail"),
                (at: (0, 4.4, 4.4), r: 1.0, lock: false),
                (at: (0, 2.6, -4.0), r: 1.0, lock: false),
                (at: (0, 1.4, -9.0), r: 0.7, lock: false),
            ],
            spells: [
                (name: "souffle", kind: Beam, element: Fire, damage: 150, radius: 1.0, reaction: Heavy,
                 life: 64, hitstop: 5, reach: (3.5, 9)),
                (name: "pluie", kind: Eruption, element: Fire, damage: 140, radius: 2.0, reaction: Heavy,
                 delay: 55, life: 22, hitstop: 5),
                (name: "boule", kind: Bolt, element: Fire, damage: 120, radius: 0.75, reaction: Heavy, speed: 14,
                 homing: 30, life: 150, hitstop: 5),
            ],
            attacks: [
                (
                    // The head rears, then slams down to the ground in front of it. It doesn't face
                    // its target (heading_slack): it turns towards it while rearing.
                    name: "coup_de_tete",
                    min_range: 0, max_range: 8.5, max_angle: 35, weight: 3, cooldown: 150, phases: [1, 2],
                    mv: (
                        anim: "headbutt", total: 112, track_until: 44, track_rate: 80,
                        motion: [(start: 46, end: 56, speed: 3.0)],
                        hits: [(start: 52, end: 60, damage: 140, hitstop: 7, reaction: Heavy,
                                capsule: (a: (0.0, 2.4, 4.0), b: (0.0, 0.6, 7.9), r: 1.2))],
                    ),
                ),
                (
                    // Rears up and lets itself fall with all its weight in front of it: flee to the side.
                    name: "plaquage",
                    min_range: 0, max_range: 7.5, max_angle: 45, weight: 3, cooldown: 320, phases: [1, 2],
                    mv: (
                        anim: "belly_flop", total: 156, track_until: 30, track_rate: 30, hyperarmor: (20, 100),
