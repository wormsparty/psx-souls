                        hits: [(start: 86, end: 96, damage: 165, hitstop: 8, reaction: Heavy, aoe: true,
                                capsule: (a: (0.0, 0.3, 4.6), b: (0.0, 0.3, 4.6), r: 4.2))],
                    ),
                ),
                (
                    // Target on its left flank: it pivots a quarter turn to the right, and
                    // the tail sweeps that whole side.
                    name: "pivot_gauche",
                    min_range: 0, max_range: 10, min_angle: 60, max_angle: 140, side: Left, weight: 2, cooldown: 300,
                    phases: [1, 2],
                    mv: (
                        anim: "pivot_L", total: 116, track_until: 0,
