                        hits: [(start: 42, end: 68, damage: 125, hitstop: 6, reaction: Heavy, arc: (0, -50),
                                capsule: (a: (0.0, 1.4, -2.6), b: (0.0, 1.0, -11.0), r: 0.9))],
                    ),
                ),
                (
                    name: "pivot_droite",
                    min_range: 0, max_range: 10, min_angle: 60, max_angle: 140, side: Right, weight: 2, cooldown: 300,
                    phases: [1, 2],
                    mv: (
                        anim: "pivot_R", total: 116, track_until: 0,
